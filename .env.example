# WanderConnect Environment Variables (Template)
# Copy this file to .env and fill in the values

# Backend API configuration (if applicable)
VITE_API_URL=https://kdbiptruhyzkqgmzpzag.supabase.co/rest/v1/

# Supabase configuration
VITE_SUPABASE_URL=https://kdbiptruhyzkqgmzpzag.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here


# Map integration keys (e.g. Mapbox, Google Maps)
VITE_MAPBOX_ACCESS_TOKEN=your_mapbox_access_token_here
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Third-party Image API (Unsplash API for travel pictures)
VITE_UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here
